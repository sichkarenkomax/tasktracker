# ---------------------------------------------------------------------------
# Copy to ".env" and adjust. Every value below has a safe default, so the
# stack also boots without this file.
# ---------------------------------------------------------------------------

# --- Application ------------------------------------------------------------
APP_NAME=TaskTracker
# Shipped as "development" so that copying this file and running
# `docker compose up` actually works. Switch to "production" for a real
# deployment - but then SECRET_KEY below must be a real secret.
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1
# Swagger UI at /api/docs. Set to false to stop publishing the full API surface.
API_DOCS_ENABLED=true

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true

# --- CORS -------------------------------------------------------------------
# Comma-separated list of allowed origins. Empty = same-origin only.
CORS_ORIGINS=

# --- Database ---------------------------------------------------------------
# POSTGRES_* configure the database container itself; the application only ever
# reads DATABASE_URL. Change the password here and DATABASE_URL together.
POSTGRES_USER=tasktracker
POSTGRES_PASSWORD=tasktracker
POSTGRES_DB=tasktracker
DATABASE_URL=postgresql+asyncpg://tasktracker:tasktracker@postgres:5432/tasktracker
DB_ECHO=false

# --- Authentication ---------------------------------------------------------
# Signs JWT access tokens. Leave empty and a strong key is generated on first
# start and kept in SECRET_KEY_FILE - that way `docker compose up` works out of
# the box without shipping a public key in the repository. Set it explicitly if
# you prefer to manage the key yourself (secret manager, several instances
# sharing one key):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Where the generated key is stored. Must be on a persistent volume: deleting
# the file invalidates every session.
SECRET_KEY_FILE=/var/lib/tasktracker/secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=1440

# --- Auth cookie ------------------------------------------------------------
# The API sets the access token as an httpOnly cookie *and* returns it in the
# body, so a browser SPA never has to keep a token in JavaScript.
# The default below suits the shipped setup, where Caddy listens on plain HTTP
# (:80) and a Secure cookie would be dropped by the browser.
# Set this to true as soon as you terminate TLS - a domain name in SITE_ADDRESS
# makes Caddy do it automatically.
AUTH_COOKIE_NAME=tt_access
AUTH_COOKIE_SECURE=false
# "lax" for a same-origin SPA; "none" additionally requires SECURE=true.
AUTH_COOKIE_SAMESITE=lax

# --- Registration -----------------------------------------------------------
# "anyone" = open sign-up (typical for a self-hosted instance).
# "invite"  = POST /auth/register returns 403; accounts are created by an admin.
REGISTRATION_MODE=anyone

# --- Pagination -------------------------------------------------------------
# Upper bound a client may ask for, and the page size used when none is given.
MAX_PAGE_SIZE=100
DEFAULT_PAGE_SIZE=25

# --- Modules ----------------------------------------------------------------
# Comma-separated list of modules to enable. Empty = every discovered module.
# Known on Phase 0: tasks
ENABLED_MODULES=

# --- Reverse proxy ----------------------------------------------------------
# Use ":80" for plain HTTP, or a domain name for automatic HTTPS.
SITE_ADDRESS=:80